{
  "type": "object",
  "additionalProperties": false,
  "required": ["changed", "changes", "reading", "cross_checks", "check_model"],
  "properties": {
    "changed": { "type": "boolean" },
    "changes": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 10 },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark", "date", "recommendations", "never_use"],
      "properties": {
        "never_use": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "effort"],
            "properties": {
              "model": { "type": "string", "pattern": "^[A-Za-z0-9 .-]{1,40}$" },
              "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] }
            }
          }
        },
        "benchmark": { "type": "string", "maxLength": 60 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "recommendations": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "tool", "model", "effort", "score_pct", "cost_usd"],
            "properties": {
              "task": { "enum": ["hardest", "everyday", "implement", "mechanical", "scout", "check"] },
              "tool": { "enum": ["claude", "codex"] },
              "model": { "type": "string", "pattern": "^[A-Za-z0-9 .-]{1,40}$" },
              "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
              "score_pct": { "type": "number" },
              "cost_usd": { "type": "number" }
            }
          }
        }
      }
    },
    "cross_checks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "status", "note"],
        "properties": {
          "source": { "type": "string", "maxLength": 60 },
          "status": { "enum": ["agrees", "disagrees", "unreadable"] },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "check_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string", "pattern": "^claude-[a-z]+-\\d+(-\\d+)?$" },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] }
      }
    }
  }
}
